{
  "name": "interlock",
  "version": "0.1.0",
  "private": true,
  "description": "Interlock — conversation-level scam protection with stage-aware safeguards.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:spacetimedb": "npm --prefix spacetimedb test",
    "spacetimedb:build": "spacetime build --module-path spacetimedb",
    "spacetimedb:start": "spacetime start --listen-addr 127.0.0.1:4000",
    "redteam": "vitest run tests/redteam.test.ts --reporter=verbose",
    "evidence": "tsx scripts/evaluate.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.25",
    "@upstash/redis": "^1.41.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redis": "^5.12.1",
    "spacetimedb": "^2.14.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
