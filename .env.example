# Copy to .env.local (or set in Vercel → Settings → Environment Variables).

# --- SpacetimeDB incident coordination ---
# Local SpacetimeDB is deliberately on port 4000, separate from Next.js.
NEXT_PUBLIC_SPACETIMEDB_URI=ws://127.0.0.1:4000
NEXT_PUBLIC_SPACETIMEDB_DATABASE=interlock-incidents

# For a separately hosted database, replace these with its public host URI
# (for example https://maincloud.spacetimedb.com) and database name or identity.
# Never put operator credentials here.

# --- Accounts and live calls ---
# Sign-in (Clerk). From the Clerk dashboard → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk JWT template that adds {"aud": "spacetimedb", "role": "{{user.public_metadata.role}}"}.
NEXT_PUBLIC_CLERK_SPACETIMEDB_TEMPLATE=spacetimedb

# Durable storage for accounts and live phone sessions.
# Connecting Upstash through Vercel's marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN instead.
# Or set only REDIS_URL (redis:// or rediss://), which Vercel's Redis integration provides.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Phone mode (Twilio). Voice webhook: POST https://<site>/api/twilio/voice
#                      Messaging webhook: POST https://<site>/api/twilio/sms
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# The protected customer's real phone, E.164. Trial accounts can only call verified numbers.
INTERLOCK_FORWARD_TO=
# conference (default, works on a Twilio trial: both people call the number) or forward (paid accounts).
INTERLOCK_CALL_MODE=conference
# Required to arm the shared demo number on a public deployment.
LIVE_ARM_CODE=
# Optional: comma-separated numbers treated as saved contacts (never transcribed).
INTERLOCK_KNOWN_NUMBERS=
# Optional: public origin for Twilio callbacks if a proxy rewrites the host.
PUBLIC_BASE_URL=
